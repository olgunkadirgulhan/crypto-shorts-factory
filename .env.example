# Copy to .env for local runs. In production these live in GitHub repo secrets.

# --- Required: script generation ---
ANTHROPIC_API_KEY=
# claude-opus-5 (best quality, ~$2.60/mo at 3 videos/day)
# claude-haiku-4-5 (cheapest, ~$0.51/mo)
CLAUDE_MODEL=claude-opus-5

# --- Required: YouTube upload ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth client (Desktop app)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Produced once by: npm run youtube:auth
YOUTUBE_REFRESH_TOKEN=

# --- Optional ---
# public | unlisted | private  (start with "unlisted" while you tune the output)
YOUTUBE_PRIVACY=unlisted
# 28 = Science & Technology, 25 = News & Politics, 22 = People & Blogs
YOUTUBE_CATEGORY_ID=28
# Free demo key from coingecko.com/en/api raises the rate limit. Works without it.
COINGECKO_API_KEY=
# Telegram run notifications (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
